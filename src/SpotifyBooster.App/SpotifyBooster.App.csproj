<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SpotifyBooster.Core\SpotifyBooster.Core.csproj" />
    <ProjectReference Include="..\SpotifyBooster.Audio\SpotifyBooster.Audio.csproj" />
    <ProjectReference Include="..\SpotifyBooster.Infrastructure\SpotifyBooster.Infrastructure.csproj" />
    <ProjectReference Include="..\SpotifyBooster.Dsp\SpotifyBooster.Dsp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Description>WPF desktop user interface for Spotify Booster.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
