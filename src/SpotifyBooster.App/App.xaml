<Application x:Class="SpotifyBooster.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SpotifyBooster.App.Converters"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Colors.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Buttons.xaml" />
        <ResourceDictionary Source="Themes/Inputs.xaml" />
        <ResourceDictionary Source="Themes/Sliders.xaml" />
        <ResourceDictionary Source="Themes/Menus.xaml" />
        <ResourceDictionary Source="Themes/Cards.xaml" />
        <ResourceDictionary Source="Themes/ScrollBarsAndMeters.xaml" />
        <ResourceDictionary Source="Themes/WindowChrome.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <converters:NavigationPageToVisibilityConverter x:Key="PageVisibilityConverter" />
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
