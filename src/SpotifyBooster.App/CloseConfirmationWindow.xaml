<Window x:Class="SpotifyBooster.App.CloseConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fermer Spotify Booster"
        Width="460"
        Height="250"
        MinWidth="420"
        MinHeight="240"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.Frame}"
        WindowStyle="None">
  <Border Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="28">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Style="{StaticResource Text.Title}"
                 Text="Que doit faire Spotify Booster ?" />

      <StackPanel Grid.Row="1"
                  Margin="0,16,0,20">
        <TextBlock Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Text="Le moteur audio peut continuer lorsque la fenêtre est masquée dans la zone de notification." />
        <TextBlock Margin="0,8,0,0"
                   Style="{StaticResource Text.Secondary}"
                   TextWrapping="Wrap"
                   Text="Choisissez « Quitter » pour arrêter complètement le traitement et libérer les périphériques audio." />
      </StackPanel>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="1"
                Margin="0,0,8,0"
                Style="{StaticResource Button.Ghost}"
                Content="Annuler"
                Click="CancelButton_Click" />
        <Button Grid.Column="2"
                Margin="0,0,8,0"
                Style="{StaticResource Button.Secondary}"
                Content="Garder en arrière-plan"
                Click="MinimizeButton_Click" />
        <Button Grid.Column="3"
                Style="{StaticResource Button.Danger}"
                Content="Quitter"
                Click="ExitButton_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>
