<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Canvas">#05090B</Color>
  <Color x:Key="Color.Rail">#080D10</Color>
  <Color x:Key="Color.Surface">#0C1215</Color>
  <Color x:Key="Color.SurfaceRaised">#121B1F</Color>
  <Color x:Key="Color.Control">#182226</Color>
  <Color x:Key="Color.ControlHover">#213036</Color>
  <Color x:Key="Color.ControlPressed">#10181B</Color>
  <Color x:Key="Color.Border">#253237</Color>
  <Color x:Key="Color.BorderStrong">#3A4C52</Color>
  <Color x:Key="Color.TextPrimary">#F3F6F8</Color>
  <Color x:Key="Color.TextSecondary">#BAC4CD</Color>
  <Color x:Key="Color.TextMuted">#96A3AE</Color>
  <Color x:Key="Color.TextInverse">#07100B</Color>
  <Color x:Key="Color.Accent">#24E879</Color>
  <Color x:Key="Color.AccentHover">#48F491</Color>
  <Color x:Key="Color.AccentPressed">#18C964</Color>
  <Color x:Key="Color.AccentMuted">#123924</Color>
  <Color x:Key="Color.Info">#84D7FF</Color>
  <Color x:Key="Color.InfoMuted">#163647</Color>
  <Color x:Key="Color.Warning">#FFCC66</Color>
  <Color x:Key="Color.WarningMuted">#493718</Color>
  <Color x:Key="Color.Danger">#FF6B7A</Color>
  <Color x:Key="Color.DangerHover">#FF8490</Color>
  <Color x:Key="Color.DangerPressed">#E85666</Color>
  <Color x:Key="Color.DangerMuted">#462027</Color>
  <Color x:Key="Color.Focus">#84D7FF</Color>
  <Color x:Key="Color.Selection">#244D3A</Color>
  <Color x:Key="Color.PopupShadow">#A6000000</Color>
  <Color x:Key="Color.Transparent">#00000000</Color>

  <SolidColorBrush x:Key="Brush.Canvas"
                   Color="{StaticResource Color.Canvas}" />
  <SolidColorBrush x:Key="Brush.Rail"
                   Color="{StaticResource Color.Rail}" />
  <SolidColorBrush x:Key="Brush.Surface"
                   Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised"
                   Color="{StaticResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.Control"
                   Color="{StaticResource Color.Control}" />
  <SolidColorBrush x:Key="Brush.ControlHover"
                   Color="{StaticResource Color.ControlHover}" />
  <SolidColorBrush x:Key="Brush.ControlPressed"
                   Color="{StaticResource Color.ControlPressed}" />
  <SolidColorBrush x:Key="Brush.Border"
                   Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.BorderStrong"
                   Color="{StaticResource Color.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.TextPrimary"
                   Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary"
                   Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextMuted"
                   Color="{StaticResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.TextInverse"
                   Color="{StaticResource Color.TextInverse}" />
  <SolidColorBrush x:Key="Brush.Accent"
                   Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover"
                   Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="Brush.AccentPressed"
                   Color="{StaticResource Color.AccentPressed}" />
  <SolidColorBrush x:Key="Brush.AccentMuted"
                   Color="{StaticResource Color.AccentMuted}" />
  <SolidColorBrush x:Key="Brush.Info"
                   Color="{StaticResource Color.Info}" />
  <SolidColorBrush x:Key="Brush.InfoMuted"
                   Color="{StaticResource Color.InfoMuted}" />
  <SolidColorBrush x:Key="Brush.Warning"
                   Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.WarningMuted"
                   Color="{StaticResource Color.WarningMuted}" />
  <SolidColorBrush x:Key="Brush.Danger"
                   Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.DangerHover"
                   Color="{StaticResource Color.DangerHover}" />
  <SolidColorBrush x:Key="Brush.DangerPressed"
                   Color="{StaticResource Color.DangerPressed}" />
  <SolidColorBrush x:Key="Brush.DangerMuted"
                   Color="{StaticResource Color.DangerMuted}" />
  <SolidColorBrush x:Key="Brush.Focus"
                   Color="{StaticResource Color.Focus}" />
  <SolidColorBrush x:Key="Brush.Selection"
                   Color="{StaticResource Color.Selection}" />
  <SolidColorBrush x:Key="Brush.PopupShadow"
                   Color="{StaticResource Color.PopupShadow}" />
  <SolidColorBrush x:Key="Brush.Transparent"
                   Color="{StaticResource Color.Transparent}" />

  <LinearGradientBrush x:Key="Brush.Surface3D"
                       StartPoint="0,0"
                       EndPoint="1,1">
    <GradientStop Offset="0"
                  Color="#151D20" />
    <GradientStop Offset="0.48"
                  Color="#0D1316" />
    <GradientStop Offset="1"
                  Color="#080D0F" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.Control3D"
                       StartPoint="0,0"
                       EndPoint="0,1">
    <GradientStop Offset="0"
                  Color="#243137" />
    <GradientStop Offset="0.5"
                  Color="#182226" />
    <GradientStop Offset="1"
                  Color="#11181B" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.Accent3D"
                       StartPoint="0,0"
                       EndPoint="0,1">
    <GradientStop Offset="0"
                  Color="#51F596" />
    <GradientStop Offset="0.48"
                  Color="#24E879" />
    <GradientStop Offset="1"
                  Color="#14BE5C" />
  </LinearGradientBrush>
</ResourceDictionary>
