<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="Slider.RepeatButton.Horizontal"
                   TargetType="RepeatButton">
    <Border Height="6" VerticalAlignment="Center" Background="{TemplateBinding Background}"
            CornerRadius="3" />
  </ControlTemplate>

  <ControlTemplate x:Key="Slider.RepeatButton.Vertical"
                   TargetType="RepeatButton">
    <Border Width="6" HorizontalAlignment="Center" Background="{TemplateBinding Background}"
            CornerRadius="3" />
  </ControlTemplate>

  <ControlTemplate x:Key="Slider.Thumb"
                   TargetType="Thumb">
    <Grid Background="{DynamicResource Brush.Transparent}">
      <Border x:Name="ThumbBody"
              Width="16"
              Height="16"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="2"
              CornerRadius="8" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver"
               Value="True">
        <Setter TargetName="ThumbBody"
                Property="Background"
                Value="{DynamicResource Brush.AccentHover}" />
        <Setter TargetName="ThumbBody"
                Property="BorderBrush"
                Value="{DynamicResource Brush.TextPrimary}" />
      </Trigger>
      <Trigger Property="IsDragging"
               Value="True">
        <Setter TargetName="ThumbBody"
                Property="Background"
                Value="{DynamicResource Brush.AccentPressed}" />
      </Trigger>
      <Trigger Property="IsEnabled"
               Value="False">
        <Setter TargetName="ThumbBody"
                Property="Opacity"
                Value="0.42" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="Slider.HorizontalTemplate"
                   TargetType="Slider">
    <Grid MinHeight="32"
          Background="{DynamicResource Brush.Transparent}">
      <Border x:Name="FocusRing"
              Margin="0,4"
              BorderBrush="{DynamicResource Brush.Transparent}"
              BorderThickness="2"
              CornerRadius="7" />
      <Border Height="6"
              Margin="8,0"
              VerticalAlignment="Center"
              Background="{DynamicResource Brush.Border}"
              CornerRadius="3" />
      <Track x:Name="PART_Track"
             Margin="8,0"
             VerticalAlignment="Center"
             IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                        Background="{DynamicResource Brush.Accent}"
                        Template="{StaticResource Slider.RepeatButton.Horizontal}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Width="16"
                 Height="24"
                 Background="{DynamicResource Brush.Accent}"
                 BorderBrush="{DynamicResource Brush.Canvas}"
                 Template="{StaticResource Slider.Thumb}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                        Background="{DynamicResource Brush.Transparent}"
                        Template="{StaticResource Slider.RepeatButton.Horizontal}" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver"
               Value="True">
        <Setter TargetName="FocusRing"
                Property="BorderBrush"
                Value="{DynamicResource Brush.BorderStrong}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin"
               Value="True">
        <Setter TargetName="FocusRing"
                Property="BorderBrush"
                Value="{DynamicResource Brush.Focus}" />
      </Trigger>
      <Trigger Property="IsEnabled"
               Value="False">
        <Setter Property="Opacity"
                Value="0.42" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="Slider.VerticalTemplate"
                   TargetType="Slider">
    <Grid MinWidth="32"
          Background="{DynamicResource Brush.Transparent}">
      <Border x:Name="FocusRing"
              Margin="4,0"
              BorderBrush="{DynamicResource Brush.Transparent}"
              BorderThickness="2"
              CornerRadius="7" />
      <Border Width="6"
              Margin="0,8"
              HorizontalAlignment="Center"
              Background="{DynamicResource Brush.Border}"
              CornerRadius="3" />
      <Track x:Name="PART_Track"
             Margin="0,8"
             HorizontalAlignment="Center"
             IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                        Background="{DynamicResource Brush.Accent}"
                        Template="{StaticResource Slider.RepeatButton.Vertical}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Width="24"
                 Height="16"
                 Background="{DynamicResource Brush.Accent}"
                 BorderBrush="{DynamicResource Brush.Canvas}"
                 Template="{StaticResource Slider.Thumb}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                        Background="{DynamicResource Brush.Transparent}"
                        Template="{StaticResource Slider.RepeatButton.Vertical}" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver"
               Value="True">
        <Setter TargetName="FocusRing"
                Property="BorderBrush"
                Value="{DynamicResource Brush.BorderStrong}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin"
               Value="True">
        <Setter TargetName="FocusRing"
                Property="BorderBrush"
                Value="{DynamicResource Brush.Focus}" />
      </Trigger>
      <Trigger Property="IsEnabled"
               Value="False">
        <Setter Property="Opacity"
                Value="0.42" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="Slider">
    <Setter Property="MinHeight"
            Value="32" />
    <Setter Property="Foreground"
            Value="{DynamicResource Brush.Accent}" />
    <Setter Property="FocusVisualStyle"
            Value="{x:Null}" />
    <Setter Property="Template"
            Value="{StaticResource Slider.HorizontalTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation"
               Value="Vertical">
        <Setter Property="MinHeight"
                Value="80" />
        <Setter Property="MinWidth"
                Value="32" />
        <Setter Property="Template"
                Value="{StaticResource Slider.VerticalTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
