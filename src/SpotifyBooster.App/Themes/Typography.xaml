<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <FontFamily x:Key="FontFamily.Ui">Segoe UI Variable, Segoe UI</FontFamily>
  <FontFamily x:Key="FontFamily.Numeric">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="FontFamily.Mono">Cascadia Mono, Consolas</FontFamily>

  <sys:Double x:Key="FontSize.Caption">11</sys:Double>
  <sys:Double x:Key="FontSize.Secondary">12</sys:Double>
  <sys:Double x:Key="FontSize.Body">13</sys:Double>
  <sys:Double x:Key="FontSize.Section">14</sys:Double>
  <sys:Double x:Key="FontSize.Title">20</sys:Double>
  <sys:Double x:Key="FontSize.Display">48</sys:Double>

  <Style x:Key="FocusVisualStyle.Control">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="2"
                  BorderBrush="{DynamicResource Brush.Focus}"
                  BorderThickness="2"
                  CornerRadius="6" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily"
            Value="{DynamicResource FontFamily.Ui}" />
    <Setter Property="FontSize"
            Value="{DynamicResource FontSize.Body}" />
    <Setter Property="TextOptions.TextFormattingMode"
            Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode"
            Value="ClearType" />
  </Style>

  <Style x:Key="Text.Caption"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground"
            Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="FontSize"
            Value="{DynamicResource FontSize.Caption}" />
    <Setter Property="LineHeight"
            Value="15" />
  </Style>

  <Style x:Key="Text.Secondary"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground"
            Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontSize"
            Value="{DynamicResource FontSize.Secondary}" />
    <Setter Property="LineHeight"
            Value="17" />
  </Style>

  <Style x:Key="Text.Section"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize"
            Value="{DynamicResource FontSize.Section}" />
    <Setter Property="FontWeight"
            Value="SemiBold" />
  </Style>

  <Style x:Key="Text.Title"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize"
            Value="{DynamicResource FontSize.Title}" />
    <Setter Property="FontWeight"
            Value="SemiBold" />
  </Style>

  <Style x:Key="Text.DisplayValue"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily"
            Value="{DynamicResource FontFamily.Numeric}" />
    <Setter Property="FontSize"
            Value="{DynamicResource FontSize.Display}" />
    <Setter Property="FontWeight"
            Value="SemiBold" />
    <Setter Property="Typography.NumeralAlignment"
            Value="Tabular" />
    <Setter Property="Typography.NumeralStyle"
            Value="Lining" />
  </Style>

  <Style x:Key="Text.Metric"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily"
            Value="{DynamicResource FontFamily.Mono}" />
    <Setter Property="FontSize"
            Value="{DynamicResource FontSize.Secondary}" />
    <Setter Property="Typography.NumeralAlignment"
            Value="Tabular" />
  </Style>
</ResourceDictionary>
