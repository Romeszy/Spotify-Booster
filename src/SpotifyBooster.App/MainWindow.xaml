<Window x:Class="SpotifyBooster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Spotify Booster"
        Icon="Assets/SpotifyBooster.ico"
        Width="1040"
        Height="720"
        MinWidth="880"
        MinHeight="620"
        Background="{DynamicResource Brush.Canvas}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource FontFamily.Ui}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        shell:WindowChrome.WindowChrome="{StaticResource WindowChrome.Standard}">
  <Window.Resources>
    <Style x:Key="TopTab.Base"
           TargetType="Button"
           BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="MinWidth"
              Value="118" />
      <Setter Property="Height"
              Value="40" />
      <Setter Property="Margin"
              Value="0,0,4,0" />
      <Setter Property="HorizontalContentAlignment"
              Value="Center" />
      <Setter Property="BorderThickness"
              Value="0,0,0,2" />
    </Style>

    <Style x:Key="TopTab.Control"
           TargetType="Button"
           BasedOn="{StaticResource TopTab.Base}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}"
                     Value="Dashboard">
          <Setter Property="Background"
                  Value="{DynamicResource Brush.SurfaceRaised}" />
          <Setter Property="BorderBrush"
                  Value="{DynamicResource Brush.Accent}" />
          <Setter Property="Foreground"
                  Value="{DynamicResource Brush.TextPrimary}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TopTab.Settings"
           TargetType="Button"
           BasedOn="{StaticResource TopTab.Base}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}"
                     Value="Settings">
          <Setter Property="Background"
                  Value="{DynamicResource Brush.SurfaceRaised}" />
          <Setter Property="BorderBrush"
                  Value="{DynamicResource Brush.Accent}" />
          <Setter Property="Foreground"
                  Value="{DynamicResource Brush.TextPrimary}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TopTab.Diagnostics"
           TargetType="Button"
           BasedOn="{StaticResource TopTab.Base}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}"
                     Value="Diagnostics">
          <Setter Property="Background"
                  Value="{DynamicResource Brush.SurfaceRaised}" />
          <Setter Property="BorderBrush"
                  Value="{DynamicResource Brush.Accent}" />
          <Setter Property="Foreground"
                  Value="{DynamicResource Brush.TextPrimary}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SetupStep.Content"
           TargetType="Border">
      <Setter Property="Visibility"
              Value="Collapsed" />
      <Setter Property="Background"
              Value="{DynamicResource Brush.Transparent}" />
    </Style>

    <Style x:Key="Setting.Group"
           TargetType="Border">
      <Setter Property="Background"
              Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush"
              Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness"
              Value="0,1,0,0" />
      <Setter Property="Padding"
              Value="0,18,0,22" />
    </Style>

    <Style x:Key="Setting.Check"
           TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin"
              Value="0,5" />
    </Style>

    <Style x:Key="Mono.Detail"
           TargetType="TextBlock"
           BasedOn="{StaticResource Text.Metric}">
      <Setter Property="Foreground"
              Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="LineHeight"
              Value="18" />
      <Setter Property="TextWrapping"
              Value="Wrap" />
    </Style>

    <DataTemplate x:Key="AudioDevice.NameTemplate">
      <TextBlock Text="{Binding Name}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Name}" />
    </DataTemplate>

    <DataTemplate x:Key="CloseBehavior.DisplayTemplate">
      <TextBlock x:Name="CloseBehaviorName"
                 Text="{Binding}" />
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding}"
                     Value="MinimizeToTray">
          <Setter TargetName="CloseBehaviorName"
                  Property="Text"
                  Value="Masquer dans la zone de notification" />
        </DataTrigger>
        <DataTrigger Binding="{Binding}"
                     Value="Ask">
          <Setter TargetName="CloseBehaviorName"
                  Property="Text"
                  Value="Demander à chaque fermeture" />
        </DataTrigger>
        <DataTrigger Binding="{Binding}"
                     Value="Exit">
          <Setter TargetName="CloseBehaviorName"
                  Property="Text"
                  Value="Quitter l’application" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border Style="{StaticResource Window.Frame}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="48" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="64" />
      </Grid.RowDefinitions>

      <!-- Custom title bar -->
      <Border Grid.Row="0"
              Style="{StaticResource Window.TitleBar}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="12,0,4,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Viewbox Width="22"
                     Height="22"
                     Margin="0,0,9,0">
              <Canvas Width="24"
                      Height="24">
                <Path Data="M 2,16 C 5,16 5,8 8,8 C 11,8 11,19 14,19 C 17,19 17,4 22,4"
                      Stroke="{DynamicResource Brush.Accent}"
                      StrokeEndLineCap="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="2.4" />
                <Path Data="M 17,4 L 22,4 L 22,9"
                      Stroke="{DynamicResource Brush.Accent}"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="2.4" />
              </Canvas>
            </Viewbox>
            <TextBlock VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Text="Spotify Booster" />
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       FontSize="11"
                       Text="UTILITAIRE AUDIO" />
            <Border Margin="14,0,0,0"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.AccentMuted}"
                    CornerRadius="9">
              <TextBlock Foreground="{DynamicResource Brush.Accent}"
                         FontSize="11"
                         Text="{Binding EngineStatusText}"
                         TextTrimming="CharacterEllipsis" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource Window.TitleBarButton}"
                    AutomationProperties.Name="Réduire la fenêtre"
                    Click="MinimizeButton_Click"
                    Content="—"
                    ToolTip="Réduire" />
            <Button Style="{StaticResource Window.TitleBarButton}"
                    AutomationProperties.Name="Agrandir ou restaurer la fenêtre"
                    Click="MaximizeButton_Click"
                    Content="□"
                    ToolTip="Agrandir ou restaurer" />
            <Button Style="{StaticResource Window.TitleBarCloseButton}"
                    AutomationProperties.Name="Fermer ou masquer la fenêtre"
                    Click="CloseButton_Click"
                    Content="×"
                    ToolTip="Fermer" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Stable top navigation -->
      <Border Grid.Row="1"
              Background="{DynamicResource Brush.Rail}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="0,0,0,1">
        <Grid Margin="16,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource TopTab.Control}"
                    AutomationProperties.Name="Ouvrir Contrôle"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Dashboard"
                    Content="Contrôle" />
            <Button Style="{StaticResource TopTab.Settings}"
                    AutomationProperties.Name="Ouvrir Réglages"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Settings"
                    Content="Réglages" />
            <Button Style="{StaticResource TopTab.Diagnostics}"
                    AutomationProperties.Name="Ouvrir Diagnostic"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Diagnostics"
                    Content="Diagnostic" />
          </StackPanel>
          <Button Grid.Column="1"
                  Style="{StaticResource Button.Secondary}"
                  MinHeight="36"
                  AutomationProperties.Name="Ouvrir l’assistant de configuration"
                  Command="{Binding RelaunchSetupCommand}"
                  Content="Assistant de routage" />
        </Grid>
      </Border>

      <!-- Global notification -->
      <Border Grid.Row="2"
              Margin="16,12,16,0"
              Padding="12,10"
              BorderThickness="1"
              CornerRadius="6"
              Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.LiveSetting="Polite">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.InfoMuted}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Info}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding NotificationSeverity}"
                           Value="Success">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.AccentMuted}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Accent}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding NotificationSeverity}"
                           Value="Warning">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.WarningMuted}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Warning}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding NotificationSeverity}"
                           Value="Error">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.DangerMuted}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Danger}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse Width="8"
                   Height="8"
                   Margin="0,2,10,0"
                   VerticalAlignment="Top"
                   Fill="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
          <StackPanel Grid.Column="1">
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding NotificationTitle}" />
            <TextBlock Margin="0,2,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="12"
                       Text="{Binding NotificationMessage}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2"
                  Style="{StaticResource Button.Ghost}"
                  Margin="12,0,0,0"
                  MinWidth="64"
                  AutomationProperties.Name="Fermer la notification"
                  Command="{Binding DismissNotificationCommand}"
                  Content="Fermer" />
        </Grid>
      </Border>

      <!-- Page host -->
      <Grid Grid.Row="3">
        <!-- Control bench -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Dashboard}">
          <StackPanel Margin="24,20,24,24">
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}"
                           Text="Banc audio" />
                <TextBlock Style="{StaticResource Text.Secondary}"
                           Margin="0,3,0,0"
                           Text="{Binding RouteStatusText}" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                <Ellipse Width="8"
                         Height="8"
                         Margin="0,0,8,0"
                         Fill="{DynamicResource Brush.Accent}" />
                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="{Binding SpotifyStatusText}" />
              </StackPanel>
            </Grid>

            <!-- Horizontal signal route -->
            <Border Style="{StaticResource Panel.Flat}"
                    Margin="0,0,0,14"
                    AutomationProperties.Name="Chemin du signal audio">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="82" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Text="SOURCE VIRTUELLE" />
                  <ComboBox Margin="0,7,0,0"
                            ItemsSource="{Binding CaptureDevices}"
                            SelectedItem="{Binding SelectedSource}"
                            ItemTemplate="{StaticResource AudioDevice.NameTemplate}"
                            IsEnabled="{Binding CanChangeDevices}"
                            MaxDropDownHeight="280"
                            AutomationProperties.Name="Source audio virtuelle" />
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Margin="0,6,0,0"
                             Text="{Binding SelectedSourceStatusText}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Column="1"
                      Margin="12,20">
                  <Path VerticalAlignment="Center"
                        Data="M 0,8 L 44,8 M 38,2 L 44,8 L 38,14"
                        Stretch="Uniform"
                        Stroke="{DynamicResource Brush.Accent}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.8" />
                  <Border Width="34"
                          Height="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Background="{DynamicResource Brush.AccentMuted}"
                          BorderBrush="{DynamicResource Brush.Accent}"
                          BorderThickness="1"
                          CornerRadius="5">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Accent}"
                               FontFamily="{DynamicResource FontFamily.Mono}"
                               FontSize="10"
                               Text="DSP" />
                  </Border>
                </Grid>

                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Text="SORTIE PHYSIQUE" />
                  <ComboBox Margin="0,7,0,0"
                            ItemsSource="{Binding RenderDevices}"
                            SelectedItem="{Binding SelectedOutput}"
                            ItemTemplate="{StaticResource AudioDevice.NameTemplate}"
                            IsEnabled="{Binding CanChangeDevices}"
                            MaxDropDownHeight="280"
                            AutomationProperties.Name="Sortie audio physique" />
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Margin="0,6,0,0"
                             Text="{Binding SelectedOutputStatusText}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="3"
                        Style="{StaticResource Button.Icon}"
                        Margin="12,20,0,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Actualiser les périphériques audio"
                        Command="{Binding RefreshDevicesCommand}"
                        Content="↻"
                        IsEnabled="{Binding CanChangeDevices}"
                        ToolTip="Actualiser les périphériques" />
              </Grid>
            </Border>

            <!-- Main instrument surface -->
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.35*" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,22,0">
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Text="GAIN PRINCIPAL" />
                  <StackPanel Orientation="Horizontal"
                              Margin="0,5,0,8">
                    <TextBlock Style="{StaticResource Text.DisplayValue}"
                               AutomationProperties.Name="Gain principal demandé"
                               Text="{Binding GainDbText}" />
                    <TextBlock Margin="14,0,0,9"
                               VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Brush.Accent}"
                               FontFamily="{DynamicResource FontFamily.Numeric}"
                               FontSize="18"
                               Text="{Binding GainPercentText}"
                               Visibility="{Binding ShowLinearPercent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </StackPanel>
                  <Slider Minimum="0"
                          Maximum="{Binding GainMaximumDb}"
                          TickFrequency="0.1"
                          SmallChange="0.1"
                          LargeChange="1"
                          IsSnapToTickEnabled="True"
                          Value="{Binding MainGainDb, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="Gain principal en décibels"
                          AutomationProperties.HelpText="De zéro au maximum autorisé par le mode actif" />
                  <Grid Margin="8,3,8,0">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="0 dB · neutre" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right"
                               Text="{Binding GainMaximumDb, StringFormat=+{0:0} dB}" />
                  </Grid>
                  <Border Style="{StaticResource Banner.Warning}"
                          Margin="0,15,0,0"
                          Visibility="{Binding HasSafetyWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Foreground="{DynamicResource Brush.Warning}"
                               FontSize="12"
                               Text="{Binding SafetyWarningText}"
                               TextWrapping="Wrap" />
                  </Border>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource Brush.Border}" />

                <StackPanel Grid.Column="2"
                            Margin="22,0,0,0">
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Text="MODE DU PIPELINE" />
                  <ListBox Margin="0,8,0,0"
                           Padding="0"
                           Background="{DynamicResource Brush.Transparent}"
                           BorderThickness="0"
                           ItemsSource="{Binding ProtectionModes}"
                           SelectedItem="{Binding ProtectionMode}"
                           AutomationProperties.Name="Mode de protection audio">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem"
                             BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Margin"
                                Value="0,0,4,0" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center" />
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock x:Name="ModeName"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding}" />
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding}"
                                       Value="Protected">
                            <Setter TargetName="ModeName"
                                    Property="Text"
                                    Value="Protégé" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding}"
                                       Value="Direct">
                            <Setter TargetName="ModeName"
                                    Property="Text"
                                    Value="Direct" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding}"
                                       Value="RawExpert">
                            <Setter TargetName="ModeName"
                                    Property="Text"
                                    Value="Expert brut" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Style="{StaticResource Text.Secondary}"
                             Margin="0,8,0,16"
                             MinHeight="34"
                             Text="{Binding ProtectionModeDescription}"
                             TextWrapping="Wrap" />

                  <Grid Margin="0,0,0,5">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="ENTRÉE" />
                    <TextBlock Style="{StaticResource Text.Metric}"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource Brush.Info}"
                               Text="{Binding InputPeakText}" />
                  </Grid>
                  <ProgressBar Style="{StaticResource Meter.Input}"
                               Maximum="100"
                               Value="{Binding InputLevel, Mode=OneWay}"
                               AutomationProperties.Name="Niveau d’entrée" />
                  <Grid Margin="0,12,0,5">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="SORTIE" />
                    <TextBlock Style="{StaticResource Text.Metric}"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource Brush.Accent}"
                               Text="{Binding OutputPeakText}" />
                  </Grid>
                  <ProgressBar Style="{StaticResource Meter.Output}"
                               Maximum="100"
                               Value="{Binding OutputLevel, Mode=OneWay}"
                               AutomationProperties.Name="Niveau de sortie" />
                  <Grid Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="{Binding ClippingStatusText}" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right"
                               Text="{Binding LimiterStatusText}" />
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Bass strip -->
            <Border Style="{StaticResource Panel.Flat}">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Style="{StaticResource Setting.Check}"
                            IsChecked="{Binding BassBoostEnabled}"
                            AutomationProperties.Name="Activer le Bass Boost"
                            Content="Bass Boost" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile}"
                            AutomationProperties.Name="Profil de Bass Boost" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <Grid Margin="0,0,0,4">
                      <TextBlock Style="{StaticResource Text.Caption}"
                                 Text="RENFORCEMENT" />
                      <TextBlock HorizontalAlignment="Right"
                                 Foreground="{DynamicResource Brush.Accent}"
                                 FontFamily="{DynamicResource FontFamily.Numeric}"
                                 Text="{Binding BassGainText}" />
                    </Grid>
                    <Slider Minimum="0"
                            Maximum="18"
                            TickFrequency="0.1"
                            SmallChange="0.1"
                            LargeChange="1"
                            Value="{Binding BassGainDb, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Renforcement des basses en décibels" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,4">
                      <TextBlock Style="{StaticResource Text.Caption}"
                                 Text="FRÉQUENCE" />
                      <TextBlock HorizontalAlignment="Right"
                                 Foreground="{DynamicResource Brush.TextSecondary}"
                                 FontFamily="{DynamicResource FontFamily.Numeric}"
                                 Text="{Binding BassFrequencyText}" />
                    </Grid>
                    <Slider Minimum="35"
                            Maximum="200"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="10"
                            Value="{Binding BassFrequencyHz, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Fréquence du Bass Boost en hertz" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <Grid Margin="0,0,0,4">
                      <TextBlock Style="{StaticResource Text.Caption}"
                                 Text="PENTE" />
                      <TextBlock HorizontalAlignment="Right"
                                 Foreground="{DynamicResource Brush.TextSecondary}"
                                 FontFamily="{DynamicResource FontFamily.Numeric}"
                                 Text="{Binding BassSlopeText}" />
                    </Grid>
                    <Slider Minimum="0.25"
                            Maximum="2"
                            TickFrequency="0.05"
                            SmallChange="0.05"
                            LargeChange="0.25"
                            Value="{Binding BassSlope, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Pente du filtre Bass Boost" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Seven-step setup -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Setup}">
          <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}"
                           Text="{Binding SetupStepTitle}" />
                <TextBlock Style="{StaticResource Text.Secondary}"
                           Margin="0,3,0,0"
                           Text="{Binding SetupProgressText}" />
              </StackPanel>
              <ProgressBar Grid.Column="1"
                           Height="8"
                           Maximum="7"
                           Value="{Binding SetupStep, Mode=OneWay}"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Progression de l’assistant" />
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="24">
              <Grid>
                <!-- Step 1 -->
                <Border>
                  <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource SetupStep.Content}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupStep}"
                                     Value="1">
                          <Setter Property="Visibility"
                                  Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Text="Spotify Booster traite le signal qui traverse un câble audio virtuel. Il ne capture pas Spotify par son processus et ne modifie pas vos réglages Windows à votre place."
                               TextWrapping="Wrap" />
                    <Viewbox Height="210"
                             Margin="0,18,0,10"
                             Stretch="Uniform">
                      <Canvas Width="760"
                              Height="180">
                        <Path Data="M 70,92 C 105,92 105,50 140,50 C 175,50 175,126 210,126"
                              Stroke="{DynamicResource Brush.Info}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="4" />
                        <Border Canvas.Left="18"
                                Canvas.Top="54"
                                Width="170"
                                Height="76"
                                Background="{DynamicResource Brush.SurfaceRaised}"
                                BorderBrush="{DynamicResource Brush.Info}"
                                BorderThickness="1"
                                CornerRadius="10">
                          <StackPanel HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Spotify" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Text="sortie choisie dans Windows" />
                          </StackPanel>
                        </Border>
                        <Path Data="M 190,92 L 278,92 M 266,80 L 278,92 L 266,104"
                              Stroke="{DynamicResource Brush.TextMuted}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="2" />
                        <Border Canvas.Left="286"
                                Canvas.Top="44"
                                Width="188"
                                Height="96"
                                Background="{DynamicResource Brush.AccentMuted}"
                                BorderBrush="{DynamicResource Brush.Accent}"
                                BorderThickness="1"
                                CornerRadius="10">
                          <StackPanel HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Brush.Accent}"
                                       FontWeight="SemiBold"
                                       Text="VB-CABLE" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,0"
                                       Text="Input → Output" />
                          </StackPanel>
                        </Border>
                        <Path Data="M 476,92 L 564,92 M 552,80 L 564,92 L 552,104"
                              Stroke="{DynamicResource Brush.TextMuted}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="2" />
                        <Border Canvas.Left="572"
                                Canvas.Top="54"
                                Width="170"
                                Height="76"
                                Background="{DynamicResource Brush.SurfaceRaised}"
                                BorderBrush="{DynamicResource Brush.Accent}"
                                BorderThickness="1"
                                CornerRadius="10">
                          <StackPanel HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Booster → casque" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Text="DSP puis sortie physique" />
                          </StackPanel>
                        </Border>
                      </Canvas>
                    </Viewbox>
                    <Border Style="{StaticResource Banner.Warning}">
                      <TextBlock Foreground="{DynamicResource Brush.Warning}"
                                 Text="Tout programme envoyé vers le câble sera traité. Gardez les jeux, le navigateur et les sons système sur leur sortie habituelle."
                                 TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>

                <!-- Step 2 -->
                <Border>
                  <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource SetupStep.Content}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupStep}"
                                     Value="2">
                          <Setter Property="Visibility"
                                  Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}"
                               Text="Téléchargez le pilote uniquement depuis son éditeur" />
                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Margin="0,8,0,18"
                               Text="VB-CABLE est un composant tiers. Spotify Booster ne le télécharge, ne l’installe et ne le redistribue pas. Vérifiez sa licence et redémarrez Windows si l’installateur le demande."
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource Button.Primary}"
                            Width="260"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Ouvrir le site officiel VB-Audio"
                            Command="{Binding OpenVbCableWebsiteCommand}"
                            Content="Ouvrir le site officiel VB-Audio" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="0,12,0,0"
                               Text="Le navigateur s’ouvre sur vb-audio.com. Aucun téléchargement n’est lancé automatiquement." />
                  </StackPanel>
                </Border>

                <!-- Step 3 -->
                <Border>
                  <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource SetupStep.Content}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupStep}"
                                     Value="3">
                          <Setter Property="Visibility"
                                  Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}"
                               Text="Windows doit exposer un côté rendu et un côté capture" />
                    <Grid Margin="0,16,0,18">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource Panel.Flat}">
                        <StackPanel>
                          <TextBlock Style="{StaticResource Text.Caption}"
                                     Text="CABLE INPUT · CÔTÉ SPOTIFY" />
                          <TextBlock Margin="0,7,0,0"
                                     Text="{Binding CableInputStatusText}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2"
                              Style="{StaticResource Panel.Flat}">
                        <StackPanel>
                          <TextBlock Style="{StaticResource Text.Caption}"
                                     Text="CABLE OUTPUT · CÔTÉ BOOSTER" />
                          <TextBlock Margin="0,7,0,0"
                                     Text="{Binding CableOutputStatusText}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource Button.Secondary}"
                              AutomationProperties.Name="Ouvrir les paramètres Son Windows"
                              Command="{Binding OpenSoundSettingsCommand}"
                              Content="Ouvrir les paramètres Son" />
                      <Button Style="{StaticResource Button.Secondary}"
                              Margin="10,0,0,0"
                              AutomationProperties.Name="Actualiser les périphériques"
                              Command="{Binding RefreshDevicesCommand}"
                              Content="Actualiser" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Step 4 -->
                <Border>
                  <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource SetupStep.Content}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupStep}"
                                     Value="4">
                          <Setter Property="Visibility"
                                  Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}"
                               Text="Affectez manuellement Spotify au câble" />
                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Margin="0,8,0,16"
                               Text="Dans Mélangeur de volume, trouvez Spotify puis choisissez CABLE Input comme périphérique de sortie. Laissez toutes les autres applications sur leurs sorties habituelles."
                               TextWrapping="Wrap" />
                    <Border Style="{StaticResource Banner.Info}"
                            Margin="0,0,0,18">
                      <TextBlock Foreground="{DynamicResource Brush.Info}"
                                 Text="Cette étape est volontairement manuelle : l’application ouvre la page Windows officielle mais ne modifie aucun routage."
                                 TextWrapping="Wrap" />
                    </Border>
                    <Button Style="{StaticResource Button.Primary}"
                            Width="260"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Ouvrir le mélangeur de volume Windows"
                            Command="{Binding OpenVolumeMixerCommand}"
                            Content="Ouvrir le mélangeur Windows" />
                  </StackPanel>
                </Border>

                <!-- Step 5 -->
                <Border>
                  <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource SetupStep.Content}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupStep}"
                                     Value="5">
                          <Setter Property="Visibility"
                                  Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Text="Choisissez le côté capture du câble comme source, puis votre casque ou vos enceintes comme sortie."
                               TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Text="SOURCE VIRTUELLE" />
                        <ComboBox Margin="0,7,0,0"
                                  ItemsSource="{Binding CaptureDevices}"
                                  SelectedItem="{Binding SelectedSource}"
                                  ItemTemplate="{StaticResource AudioDevice.NameTemplate}"
                                  AutomationProperties.Name="Source virtuelle de l’assistant" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Text="SORTIE PHYSIQUE" />
                        <ComboBox Margin="0,7,0,0"
                                  ItemsSource="{Binding RenderDevices}"
                                  SelectedItem="{Binding SelectedOutput}"
                                  ItemTemplate="{StaticResource AudioDevice.NameTemplate}"
                                  AutomationProperties.Name="Sortie physique de l’assistant" />
                      </StackPanel>
                    </Grid>
                    <Grid>
                      <TextBlock Style="{StaticResource Text.Secondary}"
                                 Text="{Binding RouteStatusText}" />
                      <Button Style="{StaticResource Button.Secondary}"
                              HorizontalAlignment="Right"
                              AutomationProperties.Name="Actualiser les périphériques audio"
                              Command="{Binding RefreshDevicesCommand}"
                              Content="Actualiser" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Step 6 -->
                <Border>
                  <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource SetupStep.Content}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupStep}"
                                     Value="6">
                          <Setter Property="Visibility"
                                  Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Text="Lancez une piste à faible volume. Le test reste à 0 dB : il vérifie le chemin, pas l’amplification."
                               TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <Grid Margin="0,0,0,5">
                          <TextBlock Style="{StaticResource Text.Caption}"
                                     Text="ENTRÉE" />
                          <TextBlock Style="{StaticResource Text.Metric}"
                                     HorizontalAlignment="Right"
                                     Text="{Binding InputPeakText}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource Meter.Input}"
                                     Maximum="100"
                                     Value="{Binding InputLevel, Mode=OneWay}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,5">
                          <TextBlock Style="{StaticResource Text.Caption}"
                                     Text="SORTIE" />
                          <TextBlock Style="{StaticResource Text.Metric}"
                                     HorizontalAlignment="Right"
                                     Text="{Binding OutputPeakText}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource Meter.Output}"
                                     Maximum="100"
                                     Value="{Binding OutputLevel, Mode=OneWay}" />
                      </StackPanel>
                    </Grid>
                    <Grid>
                      <TextBlock VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.TextSecondary}"
                                 Text="{Binding InputSignalStatusText}" />
                      <StackPanel HorizontalAlignment="Right"
                                  Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Secondary}"
                                AutomationProperties.Name="Tester le retour immédiat à zéro décibel"
                                Command="{Binding PanicCommand}"
                                Content="Tester Retour 0 dB" />
                        <Button Style="{StaticResource Button.Primary}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="Activer ou arrêter le traitement pour le test"
                                Command="{Binding ToggleEngineCommand}"
                                Content="{Binding EngineButtonText}"
                                IsEnabled="{Binding CanActivate}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Step 7 -->
                <Border>
                  <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource SetupStep.Content}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupStep}"
                                     Value="7">
                          <Setter Property="Visibility"
                                  Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}"
                               Text="Le chemin est prêt à être utilisé" />
                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Margin="0,8,0,16"
                               Text="L’assistant termine en mode Protégé, à 0 dB, avec soft clipper et limiteur actifs. Augmentez ensuite progressivement depuis Contrôle."
                               TextWrapping="Wrap" />
                    <Border Style="{StaticResource Banner.Warning}"
                            Margin="0,0,0,16">
                      <TextBlock Foreground="{DynamicResource Brush.Warning}"
                                 Text="Si aucun signal n’apparaît, revenez au mélangeur Windows, vérifiez que Spotify utilise CABLE Input et qu’aucune autre application ne partage ce câble."
                                 TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource Button.Secondary}"
                              AutomationProperties.Name="Ouvrir le mélangeur Windows pour dépannage"
                              Command="{Binding OpenVolumeMixerCommand}"
                              Content="Revoir le routage" />
                      <Button Style="{StaticResource Button.Secondary}"
                              Margin="10,0,0,0"
                              AutomationProperties.Name="Ouvrir les paramètres Son pour dépannage"
                              Command="{Binding OpenSoundSettingsCommand}"
                              Content="Vérifier les périphériques" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource Button.Secondary}"
                      AutomationProperties.Name="Étape précédente"
                      Command="{Binding PreviousSetupStepCommand}"
                      Content="Précédent" />
              <TextBlock Grid.Column="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextMuted}"
                         Text="{Binding SetupProgressText}" />
              <Button Grid.Column="2"
                      AutomationProperties.Name="Étape suivante"
                      Command="{Binding NextSetupStepCommand}"
                      Content="Suivant">
                <Button.Style>
                  <Style TargetType="Button"
                         BasedOn="{StaticResource Button.Primary}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SetupStep}"
                                   Value="7">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Grid.Column="2"
                      AutomationProperties.Name="Terminer l’assistant"
                      Command="{Binding CompleteSetupCommand}"
                      Content="Terminer à 0 dB">
                <Button.Style>
                  <Style TargetType="Button"
                         BasedOn="{StaticResource Button.Primary}">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SetupStep}"
                                   Value="7">
                        <Setter Property="Visibility"
                                Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </Grid>
          </Grid>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}">
          <StackPanel Margin="24,20,24,28">
            <TextBlock Style="{StaticResource Text.Title}"
                       Text="Réglages" />
            <TextBlock Style="{StaticResource Text.Secondary}"
                       Margin="0,3,0,14"
                       Text="Les changements audio sont publiés immédiatement. Les préférences de démarrage et d’interface sont sauvegardées localement." />

            <Border Style="{StaticResource Setting.Group}">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Section}"
                           Text="Audio" />
                <TextBlock Style="{StaticResource Text.Secondary}"
                           Margin="0,4,0,10"
                           Text="Étages du pipeline et protections actives." />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding DcBlockEnabled}"
                          Content="Bloquer la composante continue" />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding BassBoostEnabled}"
                          Content="Bass Boost" />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding EqualizerEnabled}"
                          Content="Égaliseur trois bandes" />
                <Grid Margin="27,6,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="GRAVES" />
                    <Slider Minimum="-12"
                            Maximum="12"
                            TickFrequency="0.5"
                            Value="{Binding EqualizerLowDb}"
                            AutomationProperties.Name="Égaliseur graves en décibels" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="MÉDIUMS" />
                    <Slider Minimum="-12"
                            Maximum="12"
                            TickFrequency="0.5"
                            Value="{Binding EqualizerMidDb}"
                            AutomationProperties.Name="Égaliseur médiums en décibels" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="AIGUS" />
                    <Slider Minimum="-12"
                            Maximum="12"
                            TickFrequency="0.5"
                            Value="{Binding EqualizerHighDb}"
                            AutomationProperties.Name="Égaliseur aigus en décibels" />
                  </StackPanel>
                </Grid>
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding CompressorEnabled}"
                          Content="Compresseur dynamique" />
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Seuil compresseur" />
                  <Slider Grid.Column="1"
                          Minimum="-60"
                          Maximum="0"
                          TickFrequency="0.5"
                          Value="{Binding CompressorThresholdDb}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding CompressorThresholdDb, StringFormat={}{0:0.0} dB}" />
                </Grid>
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Ratio" />
                  <Slider Grid.Column="1"
                          Minimum="1"
                          Maximum="20"
                          TickFrequency="0.1"
                          Value="{Binding CompressorRatio}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding CompressorRatio, StringFormat={}{0:0.0}:1}" />
                </Grid>
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Attaque" />
                  <Slider Grid.Column="1"
                          Minimum="0.1"
                          Maximum="200"
                          Value="{Binding CompressorAttackMs}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding CompressorAttackMs, StringFormat={}{0:0} ms}" />
                </Grid>
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Relâchement" />
                  <Slider Grid.Column="1"
                          Minimum="10"
                          Maximum="2000"
                          Value="{Binding CompressorReleaseMs}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding CompressorReleaseMs, StringFormat={}{0:0} ms}" />
                </Grid>
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Makeup gain" />
                  <Slider Grid.Column="1"
                          Minimum="-12"
                          Maximum="24"
                          Value="{Binding CompressorMakeupGainDb}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding CompressorMakeupGainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" />
                </Grid>
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding SoftClipperEnabled}"
                          Content="Soft clipper" />
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Seuil soft clipper" />
                  <Slider Grid.Column="1"
                          Minimum="-18"
                          Maximum="-0.01"
                          TickFrequency="0.1"
                          Value="{Binding SoftClipperThresholdDb}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding SoftClipperThresholdDb, StringFormat={}{0:0.0} dB}" />
                </Grid>
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Drive soft clipper" />
                  <Slider Grid.Column="1"
                          Minimum="0.5"
                          Maximum="8"
                          TickFrequency="0.1"
                          Value="{Binding SoftClipperDrive}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding SoftClipperDrive, StringFormat=×{0:0.0}}" />
                </Grid>
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding LimiterEnabled}"
                          Content="Limiteur de sortie" />
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Seuil limiteur" />
                  <Slider Grid.Column="1"
                          Minimum="-12"
                          Maximum="-0.01"
                          TickFrequency="0.1"
                          Value="{Binding LimiterThresholdDb}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding LimiterThresholdDb, StringFormat={}{0:0.0} dBFS}" />
                </Grid>
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Relâchement limiteur" />
                  <Slider Grid.Column="1"
                          Minimum="10"
                          Maximum="1000"
                          Value="{Binding LimiterReleaseMs}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding LimiterReleaseMs, StringFormat={}{0:0} ms}" />
                </Grid>
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Gain de sortie" />
                  <Slider Grid.Column="1"
                          Minimum="-12"
                          Maximum="12"
                          TickFrequency="0.1"
                          Value="{Binding OutputGainDb}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding OutputGainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" />
                </Grid>
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Lissage du gain" />
                  <Slider Grid.Column="1"
                          Minimum="0.5"
                          Maximum="250"
                          TickFrequency="0.5"
                          Value="{Binding ParameterSmoothingMs}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding ParameterSmoothingMs, StringFormat={}{0:0.0} ms}" />
                </Grid>
                <Grid Margin="27,5,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Plafond Expert" />
                  <Slider Grid.Column="1"
                          Minimum="25"
                          Maximum="1000"
                          TickFrequency="25"
                          SmallChange="1"
                          LargeChange="25"
                          Value="{Binding ExpertMaximumGainDb}" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Metric}"
                             HorizontalAlignment="Right"
                             Text="{Binding ExpertMaximumGainDb, StringFormat=+{0:0.0} dB}" />
                </Grid>
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding HeadphonesSafetyMode}"
                          Content="Avertissements renforcés au casque" />
                <TextBlock Style="{StaticResource Text.Caption}"
                           Margin="27,5,0,0"
                           Text="Le mode Protégé conserve le soft clipper et le limiteur actifs." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Setting.Group}">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Section}"
                           Text="Application" />
                <TextBlock Style="{StaticResource Text.Secondary}"
                           Margin="0,4,0,10"
                           Text="Démarrage, fermeture et notifications système." />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding StartWithWindows}"
                          Content="Démarrer avec Windows" />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding StartMinimized}"
                          Content="Démarrer masqué ou réduit" />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding StartProcessingAutomatically}"
                          Content="Activer automatiquement le traitement au démarrage" />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding WaitForDevicesOnStartup}"
                          Content="Attendre les périphériques audio au démarrage" />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding WaitForSpotifyOnStartup}"
                          Content="Attendre Spotify avant l’activation automatique" />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding NotificationsEnabled}"
                          Content="Afficher les notifications importantes" />
                <Grid Margin="0,9,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Text="Action du bouton Fermer" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding CloseBehaviors}"
                            SelectedItem="{Binding CloseBehavior}"
                            ItemTemplate="{StaticResource CloseBehavior.DisplayTemplate}"
                            AutomationProperties.Name="Comportement du bouton Fermer" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Caption}"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Text="MinimizeToTray masque la fenêtre ; Exit quitte réellement." />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Setting.Group}">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Section}"
                           Text="Interface" />
                <TextBlock Style="{StaticResource Text.Secondary}"
                           Margin="0,4,0,10"
                           Text="Préférences d’accès rapide et densité d’information." />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding GlobalHotkeysEnabled}"
                          Content="Activer les raccourcis globaux configurés" />
                <Grid Margin="27,8,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="AUGMENTER DE 1 dB" />
                    <TextBox Grid.Row="1"
                             Margin="0,5,0,10"
                             Text="{Binding IncreaseGainHotkey}" />
                    <TextBlock Grid.Row="2"
                               Style="{StaticResource Text.Caption}"
                               Text="ACTIVER / DÉSACTIVER" />
                    <TextBox Grid.Row="3"
                             Margin="0,5,0,10"
                             Text="{Binding ToggleProcessingHotkey}" />
                    <TextBlock Grid.Row="4"
                               Style="{StaticResource Text.Caption}"
                               Text="BASS BOOST" />
                    <TextBox Grid.Row="5"
                             Margin="0,5,0,0"
                             Text="{Binding ToggleBassBoostHotkey}" />
                  </Grid>
                  <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="RÉDUIRE DE 1 dB" />
                    <TextBox Grid.Row="1"
                             Margin="0,5,0,10"
                             Text="{Binding DecreaseGainHotkey}" />
                    <TextBlock Grid.Row="2"
                               Style="{StaticResource Text.Caption}"
                               Text="RETOUR À 0 dB" />
                    <TextBox Grid.Row="3"
                             Margin="0,5,0,10"
                             Text="{Binding PanicResetHotkey}" />
                    <TextBlock Grid.Row="4"
                               Style="{StaticResource Text.Caption}"
                               Text="AFFICHER / MASQUER" />
                    <TextBox Grid.Row="5"
                             Margin="0,5,0,0"
                             Text="{Binding ToggleWindowHotkey}" />
                  </Grid>
                </Grid>
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding ShowLinearPercent}"
                          Content="Afficher l’équivalent en pourcentage linéaire" />
                <CheckBox Style="{StaticResource Setting.Check}"
                          IsChecked="{Binding DetailedDiagnostics}"
                          Content="Afficher les diagnostics détaillés" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Setting.Group}">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Section}"
                           Text="Avancé" />
                <TextBlock Style="{StaticResource Text.Secondary}"
                           Margin="0,4,0,12"
                           Text="Outils de configuration manuelle. Spotify Booster ne modifie jamais silencieusement les périphériques Windows." />
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource Button.Secondary}"
                          Command="{Binding RelaunchSetupCommand}"
                          Content="Relancer l’assistant" />
                  <Button Style="{StaticResource Button.Secondary}"
                          Margin="10,0,0,0"
                          Command="{Binding OpenSoundSettingsCommand}"
                          Content="Paramètres Son" />
                  <Button Style="{StaticResource Button.Secondary}"
                          Margin="10,0,0,0"
                          Command="{Binding OpenVolumeMixerCommand}"
                          Content="Mélangeur Windows" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Diagnostics -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Diagnostics}">
          <StackPanel Margin="24,20,24,28">
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}"
                           Text="Diagnostic audio" />
                <TextBlock Style="{StaticResource Text.Secondary}"
                           Margin="0,3,0,0"
                           Text="État réel de chaque étage, sans masquer les limites de la route." />
              </StackPanel>
              <Button Grid.Column="1"
                      Style="{StaticResource Button.Primary}"
                      AutomationProperties.Name="Exporter le diagnostic texte"
                      Command="{Binding ExportDiagnosticCommand}"
                      Content="Exporter le rapport" />
            </Grid>

            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="MOTEUR ET FORMATS" />
                    <TextBlock Style="{StaticResource Mono.Detail}"
                               Margin="0,8,0,0"
                               Text="{Binding DiagnosticEngineText}" />
                    <TextBlock Style="{StaticResource Mono.Detail}"
                               Margin="0,8,0,0"
                               Text="{Binding DiagnosticFormatsText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="PROCESSUS SPOTIFY" />
                    <TextBlock Style="{StaticResource Mono.Detail}"
                               Margin="0,8,0,0"
                               Text="{Binding DiagnosticSpotifyText}" />
                  </StackPanel>
                </Grid>
                <Separator />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="PIPELINE" />
                    <TextBlock Style="{StaticResource Mono.Detail}"
                               Margin="0,8,0,0"
                               Text="{Binding DiagnosticPipelineText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="NIVEAUX PAR ÉTAGE" />
                    <TextBlock Style="{StaticResource Mono.Detail}"
                               Margin="0,8,0,0"
                               Text="{Binding DiagnosticLevelsText}" />
                  </StackPanel>
                </Grid>
                <Separator />

                <TextBlock Style="{StaticResource Text.Caption}"
                           Text="MÉTRIQUES TEMPS RÉEL" />
                <TextBlock Style="{StaticResource Mono.Detail}"
                           Margin="0,8,0,0"
                           Text="{Binding DiagnosticMetricsText}" />
                <Separator />

                <TextBlock Style="{StaticResource Text.Caption}"
                           Text="ERREURS RÉCENTES" />
                <TextBlock Style="{StaticResource Mono.Detail}"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="{Binding DiagnosticErrorsText}" />
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Secondary}"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Right"
                       Text="{Binding LastExportMessage}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Persistent transport / panic strip -->
      <Border Grid.Row="4"
              Background="{DynamicResource Brush.Rail}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="0,1,0,0"
              Padding="16,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding EngineStatusText}" />
            <TextBlock Style="{StaticResource Text.Caption}"
                       Margin="0,2,0,0"
                       Text="{Binding InputSignalStatusText}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Style="{StaticResource Button.Danger}"
                  Margin="12,0"
                  MinWidth="142"
                  AutomationProperties.Name="Retour immédiat du gain à zéro décibel"
                  Command="{Binding PanicCommand}"
                  Content="Retour 0 dB" />
          <Button Grid.Column="2"
                  Style="{StaticResource Button.Primary}"
                  MinWidth="220"
                  AutomationProperties.Name="Activer ou désactiver le traitement audio"
                  Command="{Binding ToggleEngineCommand}"
                  Content="{Binding EngineButtonText}"
                  IsEnabled="{Binding CanActivate}" />
        </Grid>
      </Border>

      <!-- Expert confirmation overlay -->
      <Grid Grid.RowSpan="5"
            Panel.ZIndex="100"
            Background="{DynamicResource Brush.Transparent}"
            Visibility="{Binding ExpertConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            KeyboardNavigation.TabNavigation="Cycle">
        <Grid>
          <Border Background="{DynamicResource Brush.Canvas}"
                  Opacity="0.82" />
          <Border Width="540"
                  MaxWidth="540"
                  Margin="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Style="{StaticResource Card}"
                  Padding="24">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Title}"
                         Foreground="{DynamicResource Brush.Warning}"
                         Text="Activer le mode Expert brut ?" />
              <TextBlock Style="{StaticResource Text.Secondary}"
                         Margin="0,10,0,0"
                         Text="Ce mode peut demander jusqu’à +1000 dB, retire la réduction automatique et n’impose ni soft clipper ni limiteur. Une telle valeur dépasse l’amplitude float32 brute : le DSP reste fini en saturant ses magnitudes internes. Elle ne procure aucune puissance physique supplémentaire."
                         TextWrapping="Wrap" />
              <Border Style="{StaticResource Banner.Warning}"
                      Margin="0,16,0,18">
                <TextBlock Foreground="{DynamicResource Brush.Warning}"
                           Text="Commencez à 0 dB, baissez le volume physique et surveillez les vu-mètres avant toute augmentation."
                           TextWrapping="Wrap" />
              </Border>
              <StackPanel HorizontalAlignment="Right"
                          Orientation="Horizontal">
                <Button Style="{StaticResource Button.Secondary}"
                        AutomationProperties.Name="Annuler le mode Expert brut"
                        Command="{Binding CancelExpertModeCommand}"
                        Content="Annuler" />
                <Button Style="{StaticResource Button.Danger}"
                        Margin="10,0,0,0"
                        AutomationProperties.Name="Confirmer le mode Expert brut"
                        Command="{Binding ConfirmExpertModeCommand}"
                        Content="Je comprends, activer" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
